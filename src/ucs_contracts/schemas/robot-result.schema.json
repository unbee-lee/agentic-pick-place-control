{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentic-pick-place-control:robot-result:1.0",
  "title": "Robot result",
  "description": "The single terminal processing result from the Robot Execution Station.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "message_id",
    "status",
    "execution",
    "verification",
    "completed_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "message_id": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "const": "DONE"
    },
    "execution": {
      "$ref": "#/$defs/execution"
    },
    "verification": {
      "$ref": "#/$defs/verification"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "INVALID_COMMAND",
            "EXECUTION_FAILED",
            "MESSAGE_ID_CONFLICT",
            "INTERNAL_ERROR"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "error"],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "COMPLETED"
              }
            }
          },
          "then": {
            "properties": {
              "error": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "NOT_STARTED"
              }
            }
          },
          "then": {
            "properties": {
              "error": {
                "allOf": [
                  {
                    "$ref": "#/$defs/error"
                  },
                  {
                    "properties": {
                      "code": {
                        "enum": [
                          "INVALID_COMMAND",
                          "MESSAGE_ID_CONFLICT",
                          "INTERNAL_ERROR"
                        ]
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "FAILED"
              }
            }
          },
          "then": {
            "properties": {
              "error": {
                "allOf": [
                  {
                    "$ref": "#/$defs/error"
                  },
                  {
                    "properties": {
                      "code": {
                        "enum": ["EXECUTION_FAILED", "INTERNAL_ERROR"]
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["NOT_STARTED", "COMPLETED", "FAILED", "CANCELLED"]
        },
        "error": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/error"
            }
          ]
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "outcome", "observed_positions", "error"],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "NOT_RUN"
              }
            }
          },
          "then": {
            "properties": {
              "outcome": {
                "type": "null"
              },
              "observed_positions": {
                "type": "null"
              },
              "error": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "COMPLETED"
              }
            }
          },
          "then": {
            "properties": {
              "outcome": {
                "type": "string",
                "enum": [
                  "IN_POSITION",
                  "INCORRECT_POSITION",
                  "OBJECT_NOT_DETECTED",
                  "DROPPED"
                ]
              },
              "error": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "FAILED"
              }
            }
          },
          "then": {
            "properties": {
              "outcome": {
                "type": "null"
              },
              "observed_positions": {
                "type": "null"
              },
              "error": {
                "$ref": "#/$defs/error"
              }
            }
          }
        }
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["COMPLETED", "FAILED", "NOT_RUN"]
        },
        "outcome": {
          "enum": [
            "IN_POSITION",
            "INCORRECT_POSITION",
            "OBJECT_NOT_DETECTED",
            "DROPPED",
            null
          ]
        },
        "observed_positions": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/target_positions"
            }
          ]
        },
        "error": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/error"
            }
          ]
        }
      }
    },
    "target_positions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["E", "B", "H"],
      "properties": {
        "E": {
          "$ref": "#/$defs/front_position"
        },
        "B": {
          "$ref": "#/$defs/front_position"
        },
        "H": {
          "$ref": "#/$defs/front_position"
        }
      }
    },
    "front_position": {
      "type": "string",
      "enum": ["front_left", "front_center", "front_right"]
    }
  }
}
